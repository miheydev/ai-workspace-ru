# Секреты и конфиденциальные данные
.env
.env.*
*.key
*.pem
credentials.*

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.vscode/settings.json
*.swp
*.swo
*~

# Большие файлы (загрузи в Knowledge/ вручную)
*.zip
*.rar
*.7z

# Выгрузки и таблицы по умолчанию не уезжают в git — репозиторий может быть общим.
# Это дефолт, а не запрет: в своём приватном репозитории строки ниже можно убрать,
# и всё будет версионироваться вместе с контекстом.
*.xlsx
*.xls
*.csv
*.pdf
*.docx
!Templates/*.docx
!Templates/*.dotx
!Templates/*.xlsx
Inbox/*
!Inbox/README.md

# Локальные настройки Claude Code — у каждого свои
.claude/settings.local.json

# автодампы сессий (хук из рабочего пространства Игоря)
.claude/context-dumps/
