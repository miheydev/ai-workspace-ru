# Секреты и конфиденциальные данные
.env
.env.*
*.key
*.pem
credentials.*

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.vscode/settings.json
*.swp
*.swo
*~

# Большие файлы (загрузи в Knowledge/ вручную)
*.zip
*.rar
*.7z

# Данные компании — технический барьер к правилу «не сюда — сколько стоит».
# Файлы остаются в вашей папке, но в git не попадают. Страховка от частой ошибки,
# а не гарантия: цифру, вписанную текстом в .md, это не остановит.
*.xlsx
*.xls
*.csv
*.pdf
*.docx
!Templates/*.docx
!Templates/*.dotx
!Templates/*.xlsx
Inbox/*
!Inbox/README.md

# Локальные настройки Claude Code — у каждого свои
.claude/settings.local.json
